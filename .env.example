# Copy to .env for local dev and fill in. .env is gitignored.
# On Vercel, set these in Project Settings → Environment Variables instead.

# REQUIRED — random secret signing the session/CSRF. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Admin dashboard login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Set to 1 in production / over HTTPS (Vercel is HTTPS)
SESSION_COOKIE_SECURE=0

# ---- Database ----
# LOCAL: leave blank → uses SQLite at instance/futureacad.db (automatic).
# VERCEL: add the "Postgres" storage in the Vercel dashboard — it injects
#   POSTGRES_URL automatically and the app uses it. No action needed here.
# POSTGRES_URL=postgres://user:pass@host/db?sslmode=require

# ---- Email (every lead is emailed here) ----
# Gmail example: create an App Password (Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your@gmail.com
LEAD_NOTIFY=where-leads-should-arrive@example.com
